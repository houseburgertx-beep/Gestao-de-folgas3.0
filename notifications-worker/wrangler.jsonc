{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "house-folgas-notifications",
  "main": "src/index.js",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "APP_ORIGIN": "https://houseburgertx-beep.github.io",
    "APP_URL": "https://houseburgertx-beep.github.io/Gestao-de-folgas3.0/",
    "FIREBASE_PROJECT_ID": "github-737ec",
    "FIREBASE_DATABASE_URL": "https://github-737ec-default-rtdb.firebaseio.com",
    "FIREBASE_ROOT": "gestao-folgas/v2",
    "VAPID_SUBJECT": "https://houseburgertx-beep.github.io/Gestao-de-folgas3.0/",
    "WA_ENABLED": "true",
    "WA_API_URL": "https://handed-behalf-functioning-hawk.trycloudflare.com/api",
    "WA_SESSION_ID": "house190",
    "WA_API_KEY": "wag_lHoXJO4s0S0yX1cD1PMLkAu4ghGmrhBl"
  },
  "services": [{"binding":"DELIVERY","service":"house-folgas-delivery"}],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "house-folgas-notifications",
      "database_id": "5ccbf2a3-06be-4f77-bcbf-fbd6ae00efeb",
      "migrations_dir": "migrations",
    },
  ],
}
